# Turso Database (for Vercel - free tier available)
TURSO_DATABASE_URL=https://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# JWT Secret for admin authentication
JWT_SECRET=your-random-secret-here

# Site URL and Domain (for WebAuthn, CORS, etc.)
SITE_URL=https://www.chillinet.ir
SITE_DOMAIN=www.chillinet.ir

# Admin credentials (first-time setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# For ParsPack hosting (MySQL)
# MYSQL_HOST=localhost
# MYSQL_USER=your_username
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=cafe

# For local development without database, it will use database.json file